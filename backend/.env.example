# PackWise Backend Environment Variables

# Server Port
PORT=5001
NODE_ENV=development

# Firebase Admin Service Account Credentials
# Option 1: Absolute or relative path to your downloaded serviceAccountKey.json file
FIREBASE_SERVICE_ACCOUNT_PATH=./config/serviceAccountKey.json

# Option 2: Single-line JSON string representation of the service account key (useful for cloud deployments)
# FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"..."}

