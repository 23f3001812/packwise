# PackWise Mobile Frontend Environment Variables (Expo)
# Copy this file to .env and insert your real Firebase and Backend settings.

# Firebase Web App Client Configuration (from Firebase Console > Project Settings > General > Your Apps)
EXPO_PUBLIC_FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
EXPO_PUBLIC_FIREBASE_APP_ID=your-app-id

# Backend REST API Base URL
# For local Web or iOS Simulator: http://localhost:5001/api
# For Android Emulator:          http://10.0.2.2:5001/api
# For Physical Android / Expo Go: http://<YOUR_COMPUTER_LOCAL_IP>:5001/api (e.g., http://192.168.1.5:5001/api)
EXPO_PUBLIC_BACKEND_URL=http://localhost:5001/api

